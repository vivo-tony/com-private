{
  "name": "mas-center",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "dev:button": "pnpm --filter @mas/components-button dev",
    "dev:components-all": "pnpm --filter @mas/components-all dev",
    "dev:docs": "pnpm --filter docs dev",
    "new": "node scripts/create-package.mjs",
    "version": "node scripts/version.mjs",
    "release": "pnpm build && pnpm -r --filter \"./packages/*\" publish",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
